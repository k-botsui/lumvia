# Documentation only. Do not put real secrets in this file.
# Native Mac startup generates ~/Library/Application Support/Lumvia/config.env.
# Docker uses scripts/configure_compose.py to create compose.env in the private data directory.
DATABASE_URL=
SECRET_KEY=
APP_URL=http://127.0.0.1:3000
ENVIRONMENT=development
BROKER_URL=
REDIS_URL=
API_INTERNAL_URL=http://127.0.0.1:8000
STORAGE_BACKEND=local
STORAGE_ROOT=
MAX_UPLOAD_BYTES=268435456
MAX_LIBRARY_BYTES=10737418240
MAX_DURATION_MS=3600000
MAX_CONCURRENT_JOBS=20
MAX_REFERENCE_ITEMS=2000
PROCESSING_TIMEOUT_SECONDS=900
SESSION_HOURS=168
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Cloud storage and external account login are not supported.
# Docker initialization uses the following variable names.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAX_MANAGED_ITEMS=500
MAX_CELLS=2000
MAX_CELLS_PER_MEDIA=100
MAX_CLIP_MS=300000
MAX_TARGETS=20
MAX_ANALYSIS_RUNS=10

# Optional future contact destination (owner/repository). Empty keeps GitHub disconnected.
# The app never submits issues, uploads logs, or adds user/library data to the URL.
SUPPORT_GITHUB_REPOSITORY=
# Public video scene previews expire after 30 minutes; 32 MB/video, 256 MB total cache.
# Default is reference-previews in the private data directory, outside the source checkout.

LOCAL_NETWORK=false
REFERENCE_PREVIEW_ROOT=
# Leave path overrides unset in real configuration to use the private defaults.
